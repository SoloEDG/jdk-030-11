{
  "name": "jdk-030-stacklatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:lift": "esbuild scripts/check-lift.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-lift.mjs --alias:@=./src --loader:.vue=empty --log-level=warning && node node_modules/.cache/check-lift.mjs"
  },
  "dependencies": {
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/compiler-sfc": "^3.5.24",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.4"
  }
}
